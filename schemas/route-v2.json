{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:switchbite:route-v2",
  "title": "Switchbite proposal routing API2",
  "description": "Strict pure-data API. Defaults and normalization are applied before SHA256 binding. Confidence is score concentration, never success probability. Estimates are observed host estimates only. Replay binding detects stale inputs; it is not an authenticity signature. Hosts own authorization and dispatch. Runtime additionally bounds bytes, depth and IDs, enforces positive total weight, and verifies replay binding.",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 2
        },
        "task": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24000
            },
            "requirements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "minItems": 0,
              "maxItems": 64,
              "uniqueItems": true
            },
            "context_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "minItems": 0,
              "maxItems": 64,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "objective"
          ],
          "additionalProperties": false
        },
        "pool": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "minItems": 0,
                "maxItems": 64,
                "uniqueItems": true
              },
              "available": {
                "type": "boolean"
              },
              "estimated_cost": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000,
                "description": "Observed host estimate in host-defined cost units; not a guaranteed fact."
              },
              "estimated_latency_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400000,
                "description": "Observed host estimate in milliseconds; not a guarantee."
              },
              "has_context": {
                "type": "boolean",
                "description": "Observed host report; omission means unknown."
              }
            },
            "required": [
              "id",
              "description",
              "capabilities",
              "available"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 16
        },
        "preferences": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8000
        },
        "policy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "profile": {
              "type": "string",
              "enum": [
                "balanced",
                "quick",
                "implementation",
                "review",
                "mockup"
              ]
            },
            "fit_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "preference_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "min_fit": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "min_context": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "min_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "tie_margin": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "tie_behavior": {
              "type": "string",
              "enum": [
                "hold",
                "stable_id",
                "lowest_cost",
                "lowest_latency"
              ]
            },
            "switch_margin": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "switch_penalty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "excluded_candidate_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "maxItems": 16,
              "uniqueItems": true
            },
            "producer_candidate_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "max_cost": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "max_latency_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            },
            "judgment_validity_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "continuity": {
          "type": "object",
          "properties": {
            "current_candidate_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "in_progress": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "replay": {
          "type": "object",
          "properties": {
            "input_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "expires_at_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "judgment": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "const": "jev-1.14.0"
                },
                "answers": {
                  "type": "object",
                  "properties": {
                    "context_sufficient": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "noul"
                        },
                        "noul": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "type",
                        "noul"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "context_sufficient"
                  ],
                  "additionalProperties": false,
                  "patternProperties": {
                    "^fit_c[0-9a-f]{64}$": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "score"
                        },
                        "score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 3
                        },
                        "confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "probabilities": {
                          "type": "object",
                          "properties": {
                            "0": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "1": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "2": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "3": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": [
                            "0",
                            "1",
                            "2",
                            "3"
                          ],
                          "additionalProperties": false
                        },
                        "legend": {
                          "type": "object",
                          "properties": {
                            "0": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
                            },
                            "1": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
                            },
                            "2": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
                            },
                            "3": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
                            }
                          },
                          "required": [
                            "0",
                            "1",
                            "2",
                            "3"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "type",
                        "score",
                        "confidence",
                        "probabilities"
                      ],
                      "additionalProperties": false
                    },
                    "^preference_c[0-9a-f]{64}$": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "score"
                        },
                        "score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 2
                        },
                        "confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "probabilities": {
                          "type": "object",
                          "properties": {
                            "0": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "1": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "2": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": [
                            "0",
                            "1",
                            "2"
                          ],
                          "additionalProperties": false
                        },
                        "legend": {
                          "type": "object",
                          "properties": {
                            "0": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
                            },
                            "1": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
                            },
                            "2": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
                            }
                          },
                          "required": [
                            "0",
                            "1",
                            "2"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "type",
                        "score",
                        "confidence",
                        "probabilities"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "usage": {
                  "type": "object",
                  "properties": {
                    "input_tokens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "output_tokens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "total_tokens": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "model",
                "answers"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "input_sha256",
            "expires_at_ms",
            "judgment"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "task",
        "pool"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 2
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "hold"
          ]
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "next_action": {
          "type": "string",
          "enum": [
            "recheck_and_dispatch",
            "clarify_task",
            "refresh_pool",
            "request_review",
            "configure_judge",
            "wait_for_completion",
            "refresh_judgment"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 16
        },
        "selected": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "candidate_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "policy_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "breakdown": {
                  "type": "object",
                  "properties": {
                    "fit": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "preference": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "context": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fit_confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "preference_confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "confidence_kind": {
                      "type": "string",
                      "const": "typesafe_score_concentration"
                    },
                    "fit_weight": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "preference_weight": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "weighted_fit": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "weighted_preference": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "switch_penalty": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "composite": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "fit",
                    "preference",
                    "context",
                    "fit_confidence",
                    "preference_confidence",
                    "confidence",
                    "confidence_kind",
                    "fit_weight",
                    "preference_weight",
                    "weighted_fit",
                    "weighted_preference",
                    "switch_penalty",
                    "composite"
                  ],
                  "additionalProperties": false
                },
                "reason_codes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "maxItems": 16
                }
              },
              "required": [
                "candidate_id",
                "policy_id",
                "breakdown",
                "reason_codes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "policy_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "breakdown": {
                "type": "object",
                "properties": {
                  "fit": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "preference": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "context": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "fit_confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "preference_confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "confidence_kind": {
                    "type": "string",
                    "const": "typesafe_score_concentration"
                  },
                  "fit_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "preference_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "weighted_fit": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "weighted_preference": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "switch_penalty": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "composite": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  }
                },
                "required": [
                  "fit",
                  "preference",
                  "context",
                  "fit_confidence",
                  "preference_confidence",
                  "confidence",
                  "confidence_kind",
                  "fit_weight",
                  "preference_weight",
                  "weighted_fit",
                  "weighted_preference",
                  "switch_penalty",
                  "composite"
                ],
                "additionalProperties": false
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "maxItems": 16
              }
            },
            "required": [
              "candidate_id",
              "policy_id",
              "breakdown",
              "reason_codes"
            ],
            "additionalProperties": false
          },
          "maxItems": 3
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "maxItems": 16
              }
            },
            "required": [
              "candidate_id",
              "reasons"
            ],
            "additionalProperties": false
          },
          "maxItems": 16
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "input_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "expires_at_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "input_sha256",
            "expires_at_ms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "status",
        "candidate_id",
        "next_action",
        "summary",
        "reason_codes",
        "selected",
        "alternatives",
        "excluded",
        "snapshot"
      ],
      "additionalProperties": false
    }
  }
}
